@model HealthAppWebAPI.Models.Dtos.CreatePatientDto

@{
    ViewBag.Title = "Register Patient";
}

<h2>Register Patient</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label>Name</label>

            @Html.TextBoxFor(
                m => m.FullName,
                new { @class = "form-control" })

            @Html.ValidationMessageFor(
                m => m.FullName,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>DOB</label>

            @Html.TextBoxFor(
                m => m.DateOfBirth,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date"
                })

            @Html.ValidationMessageFor(
                m => m.DateOfBirth,
                "",
                new { @class = "text-danger" })
        </div>
    </div> 
} 
